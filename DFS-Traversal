def DFS(graph, src=0):
    V = len(graph)
    visited = [False] * V
    res = []

    stack = []
    stack.append(src)
    visited[src] = True

    while stack:
        curr = stack.pop()
        res.append(curr)

        for i in graph[curr]:
            if not visited[i]:
                visited[i] = True
                stack.append(i)

    return res


graph = [
    [1, 2],      # 0
    [0, 3, 4],   # 1
    [0],         # 2
    [1],         # 3
    [1]          # 4
]

print("DFS Traversal:", DFS(graph, 0))
